{
  "name": "makruk-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:engine": "node -e \"require.resolve('fairy-stockfish-nnue.wasm/package.json')\" && node ../scripts/setup-browser-fairy-stockfish.mjs",
    "dev": "npm run prepare:engine && vite",
    "build": "npm run prepare:engine && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:bot-calibration": "vitest run src/test/botCalibration.test.ts",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench src/test/engine.bench.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "better-auth": "^1.6.25",
    "fairy-stockfish-nnue.wasm": "^1.1.11",
    "html-to-image": "^1.11.13",
    "posthog-js": "^1.409.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.12",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.1",
    "lightningcss-linux-x64-gnu": "^1.31.1"
  }
}
