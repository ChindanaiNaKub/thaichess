{
  "name": "makruk-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nub watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "smoke:start": "node dist/server/src/scripts/smokeStart.js",
    "test": "vitest run --config vitest.config.ts",
    "audit:puzzles": "nub src/scripts/auditPuzzles.ts",
    "audit:puzzle-candidates": "nub src/scripts/auditPuzzleCandidates.ts",
    "export:puzzle-sources": "nub src/scripts/exportPuzzleSources.ts",
    "generate:puzzle-candidates": "nub src/scripts/generatePuzzleCandidates.ts",
    "generate:selfplay": "nub src/scripts/generateSelfPlayGames.ts",
    "generate:puzzle-loop": "nub src/scripts/runPuzzleLoop.ts",
    "validate:puzzles": "nub src/scripts/validatePuzzles.ts",
    "validate:puzzle-candidates": "nub src/scripts/validatePuzzleCandidates.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.25",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@libsql/client": "^0.17.2",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "socket.io": "^4.8.0",
    "uuid": "^14.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nubjs/nub": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@libsql/linux-x64-gnu": "^0.5.28"
  }
}
